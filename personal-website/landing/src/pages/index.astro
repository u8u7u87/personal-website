	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 12px;
		position: relative;
	}

	@media (min-width: 768px) {
		.stat-item:not(:last-child)::after {
			content: '';
			position: absolute;
			right: -12px;
			top: 20%;

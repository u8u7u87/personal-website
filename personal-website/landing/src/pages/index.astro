	footer {
		text-align: center;
		padding: 40px 0 20px 0;
		color: var(--text-muted, #64748b);
		font-size: 0.85rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		margin-top: auto;
	}

	/* Floating Orbs */
	.orb {
		position: absolute;
		width: 500px;
		height: 500px;
		border-radius: 50%;
		filter: blur(130px);
		opacity: 0.12;
		z-index: -1;
		pointer-events: none;
	}

	.orb-purple {
		background: #a855f7;
		top: 10%;
		left: -100px;
		animation: float-purple 20s infinite alternate ease-in-out;
	}

	.orb-cyan {
		background: #06b6d4;
		top: 50%;
		right: -100px;
		animation: float-cyan 25s infinite alternate ease-in-out;
	}

	@keyframes float-purple {
		0% {
			transform: translate(0, 0) scale(1);
		}
		50% {
			transform: translate(80px, 50px) scale(1.1);
		}
		100% {
			transform: translate(-50px, 100px) scale(0.9);
		}
	}

	@keyframes float-cyan {
		0% {
			transform: translate(0, 0) scale(1.1);
		}
		50% {
			transform: translate(-100px, -60px) scale(0.95);
		}
		100% {
			transform: translate(60px, 40px) scale(1.05);
		}
	}

	/* Latest Writings Section */
	.latest-writings {
		border-top: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
		padding-top: 60px;
		margin-top: 20px;
		margin-bottom: 60px;
	}

	.writings-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 24px;
	}

	@media (min-width: 768px) {
		.writings-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.writing-card {
		position: relative;
		overflow: hidden;
		background: var(--glass-bg, rgba(15, 23, 42, 0.45));
		backdrop-filter: blur(var(--glass-blur, 12px));
		-webkit-backdrop-filter: blur(var(--glass-blur, 12px));
		border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.08));
		border-radius: 20px;
		text-decoration: none;
		color: var(--text-primary, #f8fafc);
		transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
					border-color 0.3s ease,
					box-shadow 0.3s ease,
					background 0.3s ease;
		box-shadow: var(--glass-shadow, 0 8px 32px 0 rgba(0, 0, 0, 0.37));
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
	}

	.writing-card::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(
			600px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
			rgba(56, 189, 248, 0.08),
			transparent 40%
		);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.4s ease;
		z-index: 1;
	}

	.writing-card::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: radial-gradient(
			350px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
			rgba(255, 255, 255, 0.2),
			transparent 50%
		);
		-webkit-mask: 
			linear-gradient(#fff 0 0) content-box, 
			linear-gradient(#fff 0 0);
		mask: 
			linear-gradient(#fff 0 0) content-box, 
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.4s ease;
		z-index: 2;
	}

	.writing-card:hover {
		transform: translateY(-6px);
		border-color: var(--glass-border-hover, rgba(255, 255, 255, 0.18));
		background: var(--glass-bg-hover, rgba(15, 23, 42, 0.65));
		box-shadow: 0 12px 40px 0 rgba(56, 189, 248, 0.15), var(--glass-shadow, 0 8px 32px 0 rgba(0, 0, 0, 0.37));
	}

	.writing-card:hover::before,
	.writing-card:hover::after {
		opacity: 1;
	}

	.writing-card > * {
		position: relative;
		z-index: 3;
	}

	.writing-image-wrapper {
		width: 100%;
		height: 200px;
		overflow: hidden;
		border-top-left-radius: 19px;
		border-top-right-radius: 19px;
		border-bottom: 1px solid var(--glass-border, rgba(255, 255, 255, 0.08));
	}

	.writing-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.writing-card:hover .writing-image {
		transform: scale(1.05);
	}

	.writing-content {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.writing-date {
		font-size: 0.8rem;
		color: var(--accent, #38bdf8);
		font-weight: 600;
		margin-bottom: 8px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.writing-title {
		font-family: var(--font-heading, 'Outfit', sans-serif);
		font-size: 1.35rem;
		font-weight: 700;
		margin: 0 0 10px 0;
		line-height: 1.3;
	}

	.writing-card:hover .writing-title {
		color: var(--accent, #38bdf8);
	}

	.writing-desc {
		font-size: 0.95rem;
		color: var(--text-secondary, #94a3b8);
		line-height: 1.5;
		margin: 0 0 20px 0;
		flex-grow: 1;
	}

	.writing-action {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent, #38bdf8);
		transition: gap 0.2s ease;
	}

	.writing-card:hover .writing-action {
		gap: 10px;
	}
</style>

<script>
	const cards = document.querySelectorAll('.glass-card, .portfolio-card, .stats-panel, .writing-card');
	cards.forEach((card) => {
		card.addEventListener('mousemove', (e) => {
			const mouseEvent = e as MouseEvent;
			const rect = card.getBoundingClientRect();
			const x = mouseEvent.clientX - rect.left;
			const y = mouseEvent.clientY - rect.top;
			(card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
			(card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
		});
	});
</script>

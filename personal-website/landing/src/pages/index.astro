			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.4s ease;
		z-index: 2;
	}

	.stats-panel:hover {
		border-color: var(--glass-border-hover, rgba(255, 255, 255, 0.18));

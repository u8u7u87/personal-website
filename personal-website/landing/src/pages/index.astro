---
import '../../../shared/global-nav.css';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { Image } from 'astro:assets';

const rootPrefix = import.meta.env.BASE_URL; // '/personal-website/'

const monorepoRoot = path.resolve(process.cwd(), '../');

const blogDir = path.join(monorepoRoot, 'blog/src/content/blog');
const analysisDir = path.join(monorepoRoot, 'analysis/docs');
const booksDir = path.join(monorepoRoot, 'books/src');

function getWordCount(filePath: string): number {
  try {
    const content = fs.readFileSync(filePath, 'utf-8');
    const cleanContent = content.trim().replace(/^---[\s\S]*?---/, '');
    const words = cleanContent.match(/[\u4e00-\u9fa5]|[a-zA-Z0-9]+(?:'[a-zA-Z0-9]+)?/g) || [];
    return words.length;
  } catch (e) {
    console.error(`Error reading or parsing ${filePath}:`, e);
    return 0;
  }
}

function getFiles(dir: string, extPattern: RegExp): string[] {
  let results: string[] = [];
  if (!fs.existsSync(dir)) return results;
  const list = fs.readdirSync(dir);
  for (const file of list) {
    const fullPath = path.join(dir, file);
    const stat = fs.statSync(fullPath);
    if (stat.isDirectory()) {
      results = results.concat(getFiles(fullPath, extPattern));
    } else if (extPattern.test(file)) {
      results.push(fullPath);
    }
  }
  return results;
}

// 1. Blog posts count and words
const blogFiles = getFiles(blogDir, /\.(md|mdx)$/);
const blogCount = blogFiles.length;
const blogWords = blogFiles.reduce((acc, file) => acc + getWordCount(file), 0);

// 2. Analysis papers count and words (excluding index.md)
const analysisFiles = getFiles(analysisDir, /\.(md|mdx)$/);
const analysisPapers = analysisFiles.filter(file => !file.endsWith('index.md'));
const analysisCount = analysisPapers.length;
const analysisWords = analysisFiles.reduce((acc, file) => acc + getWordCount(file), 0);

// 3. Book chapters count and words (matching chapter_*.md)
const booksFiles = getFiles(booksDir, /\.(md|mdx)$/);
const bookChapters = booksFiles.filter(file => {
  const name = path.basename(file);
  return name.startsWith('chapter_') && name.endsWith('.md');
});
const booksCount = bookChapters.length;
const booksWords = booksFiles.reduce((acc, file) => acc + getWordCount(file), 0);

// Totals
const totalWords = blogWords + analysisWords + booksWords;

// Format numbers
function formatNumber(num: number): string {
  return num.toLocaleString();
}

const blogImages = import.meta.glob<any>('../../../blog/src/assets/*.jpg', { eager: true });

interface Post {
  title: string;
  description: string;
  pubDateStr: string;
  heroImage: string;
  slug: string;
}

function parseYAMLField(yaml: string, field: string): string {
  const regex = new RegExp(`^${field}:\\s*(['"]?)(.*?)\\1\\s*$`, 'm');
  const match = yaml.match(regex);
  return match ? match[2].trim() : '';
}

function getLatestPosts(dir: string, count: number): Post[] {
  const files = getFiles(dir, /\.(md|mdx)$/);
  const posts: Post[] = [];

  for (const file of files) {
    try {
      const content = fs.readFileSync(file, 'utf-8');
      const match = content.match(/^---([\s\S]*?)---/);
      if (!match) continue;
      const yaml = match[1];

      const title = parseYAMLField(yaml, 'title');
      const description = parseYAMLField(yaml, 'description');
      const pubDateStr = parseYAMLField(yaml, 'pubDate');
      const heroImage = parseYAMLField(yaml, 'heroImage');
      const slug = path.basename(file, path.extname(file));

      posts.push({
        title,
        description,
        pubDateStr,
        heroImage,
        slug
      });
    } catch (e) {
      console.error(`Error parsing frontmatter for ${file}:`, e);
    }
  }

  return posts
    .sort((a, b) => new Date(b.pubDateStr).getTime() - new Date(a.pubDateStr).getTime())
    .slice(0, count);
}

function getHeroImageSrc(heroImageStr: string): any {
  if (!heroImageStr) return null;
  const filename = path.basename(heroImageStr);
  const key = `../../../blog/src/assets/${filename}`;
  return blogImages[key]?.default || null;
}

const latestPosts = getLatestPosts(blogDir, 2);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Personal Hub</title>

		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<!-- Load Outfit and Inter fonts -->
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Background Floating Orbs -->
		<div class="orb orb-purple" aria-hidden="true"></div>
		<div class="orb orb-cyan" aria-hidden="true"></div>

		<nav class="global-nav">
			<a href={rootPrefix} class="active">Home</a>
			<a href={`${rootPrefix}blog/`}>Blog</a>
			<a href={`${rootPrefix}analysis/`}>Analysis</a>
			<a href={`${rootPrefix}books/`}>Books</a>
		</nav>

		<main class="container">
			<!-- Option A Hero Typography -->
			<header class="hero">
				<h1 class="hero-title">Creative Space & <span class="gradient-text">Insights</span></h1>
				<p class="hero-subtitle">Exploring software engineering, systems architecture, reading, and industry analysis.</p>
			</header>

			<!-- Site Stats Panel -->
			<section class="stats-panel">
				<div class="stats-grid">
					<div class="stat-item">
						<span class="stat-value">{formatNumber(blogCount)}</span>
						<span class="stat-label">Blog Posts</span>
					</div>
					<div class="stat-item">
						<span class="stat-value">{formatNumber(analysisCount)}</span>
						<span class="stat-label">Analysis Papers</span>
					</div>
					<div class="stat-item">
						<span class="stat-value">{formatNumber(booksCount)}</span>
						<span class="stat-label">Book Chapters</span>
					</div>
					<div class="stat-item">
						<span class="stat-value">{formatNumber(totalWords)}</span>
						<span class="stat-label">Total Words</span>
					</div>
				</div>
			</section>

			<!-- 4-Column Responsive Grid -->
			<section class="modules-grid">
				<a href={`${rootPrefix}blog/`} class="glass-card">
					<span class="card-icon" aria-hidden="true">✍️</span>
					<h2 class="card-title">Blog</h2>
					<p class="card-desc">Personal thoughts, code tutorials, and software development guides.</p>
					<span class="card-action">Read Posts <span class="arrow">→</span></span>
				</a>

				<a href={`${rootPrefix}analysis/`} class="glass-card">
					<span class="card-icon" aria-hidden="true">📊</span>
					<h2 class="card-title">Analysis</h2>
					<p class="card-desc">Company deep dives, industry research, and analytical reports.</p>
					<span class="card-action">View Analysis <span class="arrow">→</span></span>
				</a>

				<a href={`${rootPrefix}books/`} class="glass-card">
					<span class="card-icon" aria-hidden="true">📚</span>
					<h2 class="card-title">Books</h2>
					<p class="card-desc">Long-form publishing, guides, and structured summaries of my reading.</p>
					<span class="card-action">Browse Books <span class="arrow">→</span></span>
				</a>

				<a href="#portfolio" class="glass-card">
					<span class="card-icon" aria-hidden="true">💼</span>
					<h2 class="card-title">Portfolio</h2>
					<p class="card-desc">Showcase of open-source projects, tooling, and system designs.</p>
					<span class="card-action">Explore Work <span class="arrow">→</span></span>
				</a>
			</section>

			<!-- Latest Writings Panel -->
			<section class="latest-writings">
				<h2 class="section-title">Latest Writings</h2>
				<div class="writings-grid">
					{latestPosts.map((post) => {
						const imageSrc = getHeroImageSrc(post.heroImage);
						return (
							<a href={`${rootPrefix}blog/${post.slug}/`} class="writing-card">
								{imageSrc && (
									<div class="writing-image-wrapper">
										<Image src={imageSrc} alt={post.title} width={400} height={200} class="writing-image" />
									</div>
								)}
								<div class="writing-content">
									<span class="writing-date">
										{new Date(post.pubDateStr).toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'short',
											day: 'numeric'
										})}
									</span>
									<h3 class="writing-title">{post.title}</h3>
									<p class="writing-desc">{post.description}</p>
									<span class="writing-action">Read Post <span class="arrow">→</span></span>
								</div>
							</a>
						);
					})}
				</div>
			</section>

			<!-- Portfolio Section -->
			<section id="portfolio" class="portfolio-section">
				<h2 class="section-title">Selected Projects</h2>
				<div class="portfolio-grid">
					<div class="portfolio-card">
						<h3 class="project-title">Antigravity Engine</h3>
						<p class="project-desc">A lightweight, high-performance concurrent scheduler written in Rust, leveraging fiber-like task models.</p>
						<div class="project-tags">
							<span class="tag">Rust</span>
							<span class="tag">Concurrency</span>
							<span class="tag">Systems</span>
						</div>
					</div>
					<div class="portfolio-card">
						<h3 class="project-title">Glassmorphic UI</h3>
						<p class="project-desc">A modern, responsive CSS library for glassmorphic design systems, featuring clean CSS variables.</p>
						<div class="project-tags">
							<span class="tag">CSS</span>
							<span class="tag">Design System</span>
							<span class="tag">UI/UX</span>
						</div>
					</div>
				</div>
			</section>

			<footer>
				<p>&copy; {new Date().getFullYear()} Personal Hub. Built with Astro.</p>
			</footer>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
	}
	body {
		position: relative;
		background: var(--bg-radial, radial-gradient(circle at 50% 50%, #111827 0%, #030712 100%));

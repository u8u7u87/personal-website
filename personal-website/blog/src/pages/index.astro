---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Collect and sort unique tags by post count, then alphabetically
const tagCounts = posts.reduce((acc, post) => {
	const tags = post.data.tags || [];
	tags.forEach((tag) => {
		acc[tag] = (acc[tag] || 0) + 1;
	});
	return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts)
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.map(([tag]) => tag);

function getReadingTime(text: string): string {
	const wordsPerMinute = 200;
	const numberOfWords = text.split(/\s+/).filter(Boolean).length;
	const minutes = Math.ceil(numberOfWords / wordsPerMinute);
	return `${minutes} min read`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.blog-layout {
				display: flex;
				gap: 40px;
			}
			.posts-list {
				flex: 1;
				min-width: 0;
			}
			.tags-sidebar {
				width: 240px;
				flex-shrink: 0;
				align-self: flex-start;
				position: sticky;
				top: 100px;
				background: rgba(15, 23, 42, 0.45);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 16px;
				padding: 20px;
				box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
				box-sizing: border-box;
			}
			.sidebar-title {
				font-family: var(--font-heading, 'Outfit', sans-serif);
				font-size: 1.1rem;
				font-weight: 700;
				margin-top: 0;
				margin-bottom: 15px;
				color: var(--text-primary, #f8fafc);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				padding-bottom: 8px;
			}
			.tags-list {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.sidebar-tag {
				display: flex;
				justify-content: space-between;
				align-items: center;
				color: var(--text-secondary, #94a3b8);
				text-decoration: none;
				font-size: 0.9rem;
				padding: 6px 10px;
				border-radius: 8px;
				transition: background 0.2s, color 0.2s;
			}
			.sidebar-tag:hover {
				background: rgba(56, 189, 248, 0.1);
				color: var(--accent, #38bdf8);
			}
			.tag-count {
				font-size: 0.8rem;
				background: rgba(255, 255, 255, 0.08);
				padding: 2px 6px;
				border-radius: 4px;
				color: var(--text-muted, #64748b);
				transition: background 0.2s, color 0.2s;
			}
			.sidebar-tag:hover .tag-count {
				background: var(--accent, #38bdf8);
				color: #000000;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: 100%;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--text-primary, #f8fafc);
				font-family: var(--font-heading, 'Outfit', sans-serif);
				font-size: 1.8rem;
				line-height: 1.2;
				font-weight: 700;
			}
			.metadata {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: 0.5rem;
				color: var(--text-muted, #64748b);
				font-size: 0.9rem;
				flex-wrap: wrap;
			}
			.dot {
				color: var(--text-muted, #64748b);
				opacity: 0.5;
			}
			.tag {
				font-size: 0.75rem;
				font-weight: 600;
				background: rgba(56, 189, 248, 0.1);
				color: var(--accent, #38bdf8);
				padding: 2px 8px;
				border-radius: 9999px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			ul li a:hover .title {
				color: var(--accent, #38bdf8);
			}
			ul a:hover img {
				box-shadow: var(--glass-shadow);
			}
			@media (max-width: 900px) {
				.blog-layout {
					flex-direction: column;
				}
				.tags-sidebar {
					width: 100%;
					position: static;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-layout">
				<section class="posts-list">
					<ul>
						{
							posts.map((post) => {
								const readingTime = getReadingTime(post.body || '');
								return (
									<li>
										<a href={`${import.meta.env.BASE_URL}${post.id}/`}>
											{post.data.heroImage && (
												<Image width={720} height={360} src={post.data.heroImage} alt="" />
											)}
											<h4 class="title">{post.data.title}</h4>
											<div class="metadata">
												<span class="date">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<span class="dot">•</span>
												<span class="reading-time">{readingTime}</span>
												{
													post.data.tags && post.data.tags.map((tag) => (
														<>
															<span class="dot">•</span>
															<span class="tag">{tag}</span>
														</>
													))
												}
											</div>
										</a>
									</li>
								);
							})
						}
					</ul>
				</section>
				<aside class="tags-sidebar">
					<h3 class="sidebar-title">文章标签</h3>
					<div class="tags-list">
						{
							sortedTags.map((tag) => (
								<a href={`${import.meta.env.BASE_URL}tags/${tag}/`} class="sidebar-tag">
									<span class="tag-name">#{tag}</span>
									<span class="tag-count">{tagCounts[tag]}</span>
								</a>
							))
						}
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

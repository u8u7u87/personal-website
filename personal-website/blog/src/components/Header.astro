---
import { SITE_TITLE } from '../consts';
import '../../../shared/global-nav.css';
const rootPrefix = import.meta.env.BASE_URL.replace(/blog\/$/, ''); // '/personal-website/'
---

<nav class="global-nav">
	<a href={rootPrefix}>Home</a>
	<a href={`${rootPrefix}blog/`} class="active">Blog</a>
	<a href={`${rootPrefix}analysis/`}>Analysis</a>
	<a href={`${rootPrefix}books/`}>Books</a>
</nav>

<header>
	<nav>
		<h2><a href={import.meta.env.BASE_URL}>{SITE_TITLE}</a></h2>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: transparent;
		border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-family: var(--font-heading, 'Outfit', sans-serif);
	}

	h2 a {
		color: var(--text-primary);
		text-decoration: none;
	}
	
	header nav {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 15px 0;
	}
</style>
